<!DOCTYPE html>
<html lang="ru" class="full-height">
<head>
  {% include "head-category.njk" %}
</head>
<body class="page__body full-height">
  <div class="wrapper">
    {% include "header.njk" %}
    <main class="page__main main">
      <header class="category-header">
        <div class="category-header__container container">
          <div class="category-header__content">
            <h1 class="category-header__title">{{ cat }}</h1>
            <p class="category-header__meta">страница {{ pagination.pageNumber + 1 }} из {{ pagination.pages.length }}</p>
          </div>
        </div>
      </header>
      <section class="all-posts">
        <div class="container">
          <div class="all-posts__list">
            {{ content | safe }}
          </div>
        </div>
      </section>
      {% include "pagination.njk" %}
    </main>
    {% include "footer.njk" %}
    <span class="overlay"></span>
  </div>
  <script src="/js/script.min.js" defer></script>
</body>
</html>