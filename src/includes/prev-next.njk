{% set previousPost = collections.posts | getNextCollectionItem(page) %}
{% set nextPost = collections.posts | getPreviousCollectionItem(page) %}
<div class="page__prev-next prev-next">
  <div class="prev-next__container container">
  {% if previousPost %}
  <div class="prev-next__prev">
    <h2 class="prev-next__title">
      <a class="prev-next__link" href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>
    </h2>
  </div>
  {% endif %}
  {% if nextPost %}
  <div class="prev-next__next">
    <h2 class="prev-next__title">
      <a class="prev-next__link" href="{{ nextPost.url }}">{{ nextPost.data.title }}</a>
    </h2>
  </div>
  {% endif %}
  </div>
</div>
