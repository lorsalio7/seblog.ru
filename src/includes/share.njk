<div class="full-post__share share">
  <ul class="share__list">
    <li class="share__item">
      <a class="share__link share__link--tw" href="https://twitter.com/intent/tweet?text={{ title }}&url={{ siteUrl }}{{ page.url }}&utm_source=share2" title="Поделиться в X"></a>
    </li>
    <li class="share__item">
      <a class="share__link share__link--mm" href="https://connect.mail.ru/share?url={{ siteUrl }}{{ page.url }}&title={{ title }}&utm_source=share2" title="Поделиться в Мой мир"></a>
    </li>
    <li class="share__item">
      <a class="share__link share__link--ok" href="https://connect.ok.ru/offer?url={{ siteUrl }}{{ page.url }}&title={{ title }}&utm_source=share2" title="Поделиться в Одноклассники"></a>
    </li>
    <li class="share__item">
      <a class="share__link share__link--tg" href="https://t.me/share/url?url={{ siteUrl }}{{ page.url }}&text={{ title }}&utm_source=share2" title="Поделиться в Телеграм"></a>
    </li>
    <li class="share__item">
      <a class="share__link share__link--vk" href="https://vk.com/share.php?url={{ siteUrl }}{{ page.url }}&title={{ title }}&utm_source=share2" title="Поделиться в Вконтакте"></a>
    </li>
  </ul>
</div>