<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | {{ siteTitle }}</title>
{% include "search-data.njk" %}
<meta property="og:locale" content="ru_RU" />
<meta name="description" content="{{ description }}" />
<meta property="og:description" content="{{ description }}" />
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
<meta property="og:url" content="{{ siteUrl }}{{ page.url }}" />
<meta property="og:site_name" content="{{ siteTitle }}" />
{% if postimage %}
<meta property="og:image" content="{{ site.url }}{{ postimage }}" />
{% else %}
<meta property="og:image" content="{{ siteUrl }}/img/imagehome.jpg" />
{% endif %}
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary" />
<meta property="twitter:title" content="{{ title }}" />
<meta property="twitter:description" content="{{ description }}" />
{% if page.postimage %}
<meta property="twitter:image" content="{{ site.url }}{{ postimage }}" />
{% else %}
<meta property="twitter:image" content="{{ siteUrl }}/img/imagehome.jpg" />
{% endif %}
{% if custom_styles %}
<link rel="stylesheet" href="{{ custom_styles }}">
{% endif %}

<link rel="stylesheet" href="/css/styles.min.css">