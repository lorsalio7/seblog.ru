<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if pagination.pageNumber == 0 %}
<title>{{ siteTitle }}</title>
{% else %}
<title>{{ siteTitle }} - Страница {{ pagination.pageNumber + 1 }}</title>
{% endif %}
{% include "search-data.njk" %}
{% if page.url != "/" %}
<link rel="canonical" href="{{ siteUrl }}/">
{% endif %}
{% if pagination.href.previous %}
<link rel="prev" href="{{ siteUrl }}{{ pagination.href.previous }}">
{% endif %}
{% if pagination.href.next %}
<link rel="next" href="{{ siteUrl }}{{ pagination.href.next }}">
{% endif %}
<meta property="og:locale" content="ru_RU" />
<meta name="description" content="{{ siteDescription }}" />
<meta property="og:description" content="{{ siteDescription }}" />
<link rel="icon" type="image/png" href="/img/favicon.png">
<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
<meta property="og:url" content="{{ siteUrl }}/" />
<meta property="og:site_name" content="{{ siteName }}" />
<meta property="og:image" content="{{ siteUrl }}/img/imagehome.jpg" />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary" />
<meta property="twitter:title" content="{{ siteTitle }}" />
<meta property="twitter:description" content="{{ siteDescription }}" />
<meta property="twitter:image" content="{{ siteUrl }}/img/imagehome.jpg" />
<link rel="stylesheet" href="/css/styles.min.css">